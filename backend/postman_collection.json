              "raw": "{\n  \"name\": \"Haircut\",\n  \"description\": \"Professional haircut service\",\n  \"durationMinutes\": 30,\n  \"price\": 25.00\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/services",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "services"]
            }
          }
        },
        {
